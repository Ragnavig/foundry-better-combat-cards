<section class="tooltip-part bccc-entry" data-kind="{{ kind }}">
    <div class="dice">
        <span class="bccc-label">{{ label }}</span>
        {{#if dice.length}}
        <ol class="dice-rolls">
            {{#each dice}}
            <li class="roll {{ classes }}">{{{ result }}}</li>
            {{/each}}
        </ol>
        {{/if}}
        <span class="bccc-value">{{ dnd5e-formatModifier value }}</span>
    </div>
    {{#if note}}
    <p class="bccc-note">{{ note }}</p>
    {{/if}}
</section>
