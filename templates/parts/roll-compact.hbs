<button type="button" class="dice-roll bccc-dice-roll {{ classes }}" {{ disabled isPrivate }}>
    <span class="icons">
        {{#each icons}}
        <i class="fa-solid {{ this }}" inert></i>
        {{/each}}
    </span>
    {{#if bccc.advantage.show}}
    <span class="bccc-advantage-badge" data-mode="{{ bccc.advantage.mode }}" data-tooltip
          aria-label="{{ bccc.advantage.tooltip }}">
        <i class="fa-solid {{ bccc.advantage.icon }}" inert></i>
    </span>
    {{/if}}
    <span class="result">
        <strong class="total">{{ total }}</strong>
    </span>
    {{#if bccc.advantage.dropped.length}}
    <span class="bccc-dropped" data-tooltip aria-label="{{ localize "BCCC.Breakdown.Dropped" }}">
        {{#each bccc.advantage.dropped}}
        <span class="bccc-die">
            <i class="fa-fw fa-solid fa-hexagon fa-rotate-90" inert></i>
            <span class="roll">{{ this }}</span>
        </span>
        {{/each}}
    </span>
    {{/if}}
    {{#if d20}}
    <span class="d20die">
        <i class="fa-fw fa-solid fa-hexagon fa-rotate-90" inert></i>
        <span class="roll">{{ d20.total }}</span>
    </span>
    {{/if}}
</button>
{{#if bccc.showBreakdown}}
{{#unless bccc.inline}}
<div class="roll-breakdown" popover>
    {{> "bccc.breakdown" breakdown=bccc.breakdown advantage=bccc.advantage }}
</div>
{{/unless}}
{{else}}
<div class="roll-breakdown" popover>{{{ tooltip }}}</div>
{{/if}}
{{#if bccc.showBreakdown}}
{{#if bccc.inline}}
<div class="bccc-inline-breakdown">
    {{> "bccc.breakdown" breakdown=bccc.breakdown advantage=bccc.advantage }}
</div>
{{/if}}
{{/if}}
