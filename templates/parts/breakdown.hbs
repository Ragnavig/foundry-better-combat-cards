<div class="dice-tooltip-collapser bccc-breakdown">
    <div class="dice-tooltip">
        {{#if breakdown.groups}}
        {{#each breakdown.groups}}
        <section class="bccc-group">
            <header class="bccc-group-header">
                {{#if icon}}<img src="{{ icon }}" alt="{{ label }}">{{/if}}
                <span class="label">{{ label }}</span>
                {{#if critical}}
                <span class="bccc-tag" data-tooltip aria-label="{{ localize "BCCC.Breakdown.Crit" }}">
                    {{ localize "DND5E.Critical" }}
                </span>
                {{/if}}
                <span class="value">{{ total }}</span>
            </header>
            {{#each entries}}
            {{> "bccc.breakdown-entry" }}
            {{/each}}
        </section>
        {{/each}}
        {{else}}
        {{#each breakdown.entries}}
        {{> "bccc.breakdown-entry" }}
        {{/each}}
        {{/if}}

        {{#unless breakdown.entries.length}}
        {{#unless breakdown.groups.length}}
        <p class="bccc-empty">{{ localize "BCCC.Breakdown.NoSources" }}</p>
        {{/unless}}
        {{/unless}}

        {{#if breakdown.showTotal}}
        <section class="tooltip-part bccc-entry bccc-sum">
            <div class="dice">
                <span class="bccc-label">{{ localize "BCCC.Breakdown.Total" }}</span>
                <span class="bccc-value">{{ breakdown.total }}</span>
            </div>
        </section>
        {{/if}}

        {{#if breakdown.approximate}}
        <p class="bccc-empty">{{ localize "BCCC.Breakdown.Approximate" }}</p>
        {{/if}}
    </div>
</div>
