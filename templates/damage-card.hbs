<div class="chat-card">

    {{!-- Header --}}
    {{> "dnd5e.card-header" }}

    {{!-- Supplements --}}
    {{#if onSave}}
    <p class="supplement"><strong>{{ localize "DND5E.SAVE.OnSave" }}</strong> {{ onSave }}</p>
    {{/if}}

    {{!-- Rows --}}
    {{> "dnd5e.card-rows" }}
</div>

{{!-- Rolls --}}
<section class="icon-row">
    <i class="fa-fw fa-solid fa-dice" aria-label="{{ localize "DND5E.CHATMESSAGE.Row.Roll" }}"></i>
    <button type="button" class="dice-roll" {{ disabled isPrivate }}>
        <span class="result">
            <strong class="total">{{ ifThen isPrivate "?" total }}</strong>
        </span>
    </button>
    {{#unless isPrivate}}
    {{#unless bccc.inline}}
    <div class="roll-breakdown" popover>
        {{#if bccc.showBreakdown}}
        {{> "bccc.breakdown" breakdown=bccc.breakdown }}
        {{else}}
        {{> "dnd5e.damage-breakdown" }}
        {{/if}}
    </div>
    {{/unless}}
    {{/unless}}
    {{#if bccc.inline}}
    {{#if bccc.showBreakdown}}
    <div class="bccc-inline-breakdown">
        {{> "bccc.breakdown" breakdown=bccc.breakdown }}
    </div>
    {{/if}}
    {{/if}}
</section>

{{!-- Target tools --}}
{{> "bccc.target-tools" }}

{{#if showTray}}
<damage-application class="dnd5e2"></damage-application>
{{/if}}
